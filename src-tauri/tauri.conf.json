{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OF OnlyFiles",
  "version": "0.2.0",
  "identifier": "de.infralatis.onlyfiles",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "OF OnlyFiles",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "theme": "Light",
        "backgroundColor": "#F4F8FC",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "infralatis",
    "category": "Utility",
    "shortDescription": "Speicherplatz-Analyse für macOS",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "mainBinaryName": "OnlyFiles",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3OUQyRkMyQUY2Mzk5ODAKUldTQW1XT3Z3aStkdHdhbWpqblMxdVRlZjV6YmIzY2NUcWNMQnAycUNsQnEwUjJISTVEc1ZUdzAK",
      "endpoints": [
        "https://github.com/klopsnic-cyber/onlyfiles/releases/latest/download/latest.json"
      ]
    }
  }
}